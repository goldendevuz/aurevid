# Copy to .env and fill in. NEVER commit .env.
# Generate secrets:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   cd backend && uv run python -m app.cli gen-key                         -> BYOK_ENCRYPTION_KEY

APP_ENV=dev                      # dev | prod  (prod refuses weak/missing secrets)
JWT_SECRET=
BYOK_ENCRYPTION_KEY=             # enables "bring your own key"; losing it makes saved keys unreadable

# Cookies / origins. In prod behind HTTPS: COOKIE_SECURE=true, CORS_ORIGINS=["https://your.domain"]
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Database: SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://aurevid:password@db:5432/aurevid
# RATE_LIMIT_STORAGE=redis://localhost:6379/0   # default memory:// (single process only)

# Free providers
CLOUDFLARE_ENABLED=true
CF_ACCOUNT_ID=                   # optional shared server key (free daily allocation)
CF_API_TOKEN=                    # token with "Workers AI: Read" permission only
POLLINATIONS_ENABLED=false       # terms not verified: opt in only for personal testing

# Paid providers (bring-your-own-key only), off by default
FAL_ENABLED=false

# Offline demo provider for local development (refused when APP_ENV=prod)
MOCK_PROVIDER_ENABLED=true

# Abuse protection (Cloudflare Turnstile, free). Leave empty to disable in dev.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Limits
DAILY_JOB_LIMIT=30
SIGNUP_CREDITS=50

# AGPL: link users to the source of the exact version you run
VITE_SOURCE_URL=
