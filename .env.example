# Copy to .env and fill in. NEVER commit .env.
# Generate secrets:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"            -> JWT_SECRET
#   cd backend && uv run python -m app.cli gen-key                         -> BYOK_ENCRYPTION_KEY

APP_ENV=dev                      # dev | prod  (prod refuses weak/missing secrets)
JWT_SECRET=
BYOK_ENCRYPTION_KEY=             # enables "bring your own key"; losing it makes saved keys unreadable

# Cookies / origins. In prod behind HTTPS: COOKIE_SECURE=true, CORS_ORIGINS=["https://your.domain"]
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Database: SQLite by default; PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://aurevid:password@db:5432/aurevid
# RATE_LIMIT_STORAGE=redis://localhost:6379/0   # default memory:// (single process only)

# Free providers
CLOUDFLARE_ENABLED=true
# Optional shared server key (free daily allocation). Token: https://dash.cloudflare.com/profile/api-tokens
# (Create Token -> template "Workers AI"). Account ID: https://developers.cloudflare.com/fundamentals/account/find-account-and-zone-ids/
CF_ACCOUNT_ID=
CF_API_TOKEN=
POLLINATIONS_ENABLED=false       # terms not verified: opt in only for personal testing

# Paid providers: each user adds their own key in Settings (the server never pays)
# Get a fal.ai key: https://fal.ai/dashboard/keys
FAL_ENABLED=true
FAL_VIDEO_UPSCALE_ENABLED=true   # 4K/8K video via Topaz on fal

# Free local AI upscaling to 4K/8K images (Real-ESRGAN on CPU, no API)
UPSCALER_ENABLED=true
UPSCALER_THREADS=0               # 0 = all cores but one
UPSCALER_TIMEOUT_SECONDS=300

# Queue / resource control (protects small servers from overload)
WORKER_SLOTS=3                   # jobs one worker runs at once
CPU_JOB_CONCURRENCY=1            # heavy CPU jobs (upscaling) at once, across workers
PROVIDER_CONCURRENCY=2           # in-flight jobs per provider
MAX_ACTIVE_JOBS_PER_USER=3       # queued + running per user
MAX_QUEUE_LENGTH=200             # all users; beyond this new jobs get 503 + Retry-After

# Offline demo provider for local development (refused when APP_ENV=prod)
MOCK_PROVIDER_ENABLED=true

# Abuse protection (Cloudflare Turnstile, free). Leave empty to disable in dev.
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# Limits
DAILY_JOB_LIMIT=30
SIGNUP_CREDITS=50

# AGPL: link users to the source of the exact version you run
VITE_SOURCE_URL=
